# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Vercel Blob read/write token (required on Vercel so media persists in the cloud).
# Create a Blob store in the Vercel dashboard (Storage → Blob) or via:
#   vercel blob create-store <name> --access public --yes
# Then pull env vars locally with: vercel env pull
BLOB_READ_WRITE_TOKEN=

# Public Blob CDN origin used by the frontend to rewrite /api/media/file/... URLs.
# Example: https://<storeId>.public.blob.vercel-storage.com
NEXT_PUBLIC_BLOB_BASE_URL=

# Optional: map relative /api/media/file URLs to Picsum placeholders (local demos only).
# Do NOT enable on production once Blob is configured.
# NEXT_PUBLIC_MEDIA_PICSUM_FALLBACK=true
